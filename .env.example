# Copiar a .env y llenar. .env NUNCA se sube al repositorio.
NODE_ENV=production
VERSION=actual

# Base de datos
DB_ADMIN_PASSWORD=            # openssl rand -base64 24
APP_DB_PASSWORD=              # openssl rand -base64 24

# Secretos de la aplicación
APP_SECRETO=                  # openssl rand -base64 48
ARCHIVOS_LLAVE=               # openssl rand -base64 32   (¡respaldarla aparte! sin ella no se abren los archivos)

# Dominio
DOMINIO_BASE=logistics.strateggia.mx
DESPACHO_POR_DEFECTO=strateggia
SERVIDOR_IP=                  # IP del VPS (solo para scripts; nunca en el código)

# Puertos en el servidor (solo escuchan en 127.0.0.1; confirmar que no choquen con CertifAI)
WEB_PUERTO_HOST=3100
API_PUERTO_HOST=3101

# Marce (IA). Sin llave, Marce responde solo con datos del sistema.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5

# WhatsApp (WATI). Sin esto, nada se envía por WhatsApp.
WATI_URL=
WATI_TOKEN=

# Correo del despacho (relay). Sin esto, nada se envía por correo.
CORREO_RELAY_URL=
CORREO_RELAY_TOKEN=
CORREO_REMITENTE=

# Entradas (WhatsApp de WATI y correo reenviado). URL: /api/entradas/whatsapp?despacho=strateggia&token=...
ENTRADAS_TOKEN=               # openssl rand -hex 24

# Trabajador
WORKER_MINUTOS=60

# Respaldos fuera de IONOS (rclone). Ej.: "b2:strateggia-respaldos/logistics"
RESPALDO_DESTINO_REMOTO=
RESPALDO_CLAVE_GPG=           # frase para cifrar los respaldos (guardar en lugar seguro)
