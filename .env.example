# Copiar a .env y llenar. .env NUNCA se sube al repositorio.
NODE_ENV=production
VERSION=actual

# Base de datos
DB_ADMIN_PASSWORD=            # openssl rand -base64 24
APP_DB_PASSWORD=              # openssl rand -base64 24

# Secretos de la aplicación
APP_SECRETO=                  # openssl rand -base64 48
ARCHIVOS_LLAVE=               # openssl rand -base64 32   (¡respaldarla aparte! sin ella no se abren los archivos)

# Dominio
DOMINIO_BASE=logistics.strateggia.mx
DESPACHO_POR_DEFECTO=strateggia
SERVIDOR_IP=                  # IP del VPS (solo para scripts; nunca en el código)

# Puertos en el servidor (solo escuchan en 127.0.0.1; confirmar que no choquen con CertifAI)
WEB_PUERTO_HOST=3100
API_PUERTO_HOST=3101

# Marce (IA). Sin llave, Marce responde solo con datos del sistema.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5

# WhatsApp por wa-mcp (plataforma propia, número compartido; Logistics = sistema "lg")
WA_MCP_URL=https://whats.certifaiperson.com/api/v1
WA_LLAVE=                     # npm run espacio -- llave strateggia "Logistics" --sistema lg
WA_SECRETO_WEBHOOK=           # npm run espacio -- callback strateggia https://logistics.strateggia.mx/api/entradas/wa-mcp?despacho=strateggia --sistema lg
WA_PLANTILLA=lg_recordatorio  # plantilla aprobada por Meta para reabrir conversaciones
WA_PLANTILLA_CATEGORIA=marketing  # la categoría que Meta le asignó (marketing o utility)
WA_REAL=0                     # interruptor: 1 = sí se envían mensajes

# Correo saliente por Mailrelay (la misma cuenta que CertifAI y VerifyPerson)
MAILRELAY_BASE_URL=
MAILRELAY_API_KEY=
MAILRELAY_FROM_EMAIL=         # remitente dado de alta en Mailrelay
MAILRELAY_FROM_NAME="Strateggia Logistics"
MAILRELAY_REAL=0              # interruptor: 1 = sí se envían correos
CORREO_COPIA=                 # opcional: copia de todo correo que sale (p. ej. strateggia2014@gmail.com)

# Correo del despacho. Opción recomendada: la cuenta de Mayela con una
# "contraseña de aplicación" de Google (Cuenta de Google → Seguridad → Contraseñas de aplicaciones).
# Envío (SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=                   # contraseña de aplicación (no la contraseña normal)
CORREO_REMITENTE=             # p. ej. "Mayela Romero · Strateggia <correo@...>"
# Lectura de notificaciones de la ATTRAPI (IMAP, SOLO LECTURA: no borra ni marca nada):
IMAP_HOST=imap.gmail.com
IMAP_PUERTO=993
IMAP_USUARIO=
IMAP_CLAVE=                   # la misma contraseña de aplicación
IMAP_DIAS=3                   # cuántos días hacia atrás revisa en cada ciclo
# Alternativa: un servicio "relay" HTTP propio en lugar de SMTP
CORREO_RELAY_URL=
CORREO_RELAY_TOKEN=

# Entradas (WhatsApp de WATI y correo reenviado). URL: /api/entradas/whatsapp?despacho=strateggia&token=...
ENTRADAS_TOKEN=               # openssl rand -hex 24

# Trabajador
WORKER_MINUTOS=15            # cada cuánto corre el trabajador (plazos, recordatorios, correo)

# Respaldos fuera de IONOS (rclone). Ej.: "b2:strateggia-respaldos/logistics"
RESPALDO_DESTINO_REMOTO=
RESPALDO_DIAS_DIARIO_REMOTO=30    # días que se guardan las copias diarias en Drive
RESPALDO_DIAS_SEMANAL_REMOTO=92   # días que se guardan las copias semanales (≈3 meses)
RESPALDO_OPT_EXCLUIR=          # carpetas de /opt que no se respaldan cada semana, p. ej. verifyperson-historico
RESPALDO_CLAVE_GPG=           # frase para cifrar los respaldos (guardar en lugar seguro)
